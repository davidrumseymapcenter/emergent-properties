---
classes:
  - quire-page
layout: base.11ty.js
description: Single page default template
---

{% pageHeader
  byline_format=byline_format,
  image=image,
  label=label,
  pageContributors=pageContributors,
  subtitle=subtitle,
  title=title,
  page_pdf_output=page_pdf_output,
  key=key,
  outputs=outputs
%}
{% if content %}
<section class="section quire-page__content">
  <div class="container">
    <div class="content">
      {% comment %}
      `header_image` (front matter): a small icon floated into the top left of
      the text, as on the collection section pages. A separate key from
      `image`, which pageHeader turns into a cropped background banner.
      Styles: custom.css (screen, PDF) and epub.scss (EPUB).
      {% endcomment %}
      {% if header_image %}
      {% assign headerImagePath = config.figures.imageDir | concat: header_image | join: '/' %}
      <img class="section-icon" src="{{ headerImagePath }}" alt="{{ header_image_alt }}" />
      {% endif %}
      {{ content }}
      {% bibliography citations outputs page_pdf_output %}
    </div>
  </div>
</section>
{% endif %}
<section class="section quire-page__content">
  <div class="container">
    {% pageButtons pagination=pagination %}
  </div>
</section>
